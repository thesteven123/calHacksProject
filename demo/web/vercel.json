{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://thesteven123--dfd-demo-web.us-east.modal.run/api/:path*" },
    { "source": "/media/:path*", "destination": "https://thesteven123--dfd-demo-web.us-east.modal.run/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
