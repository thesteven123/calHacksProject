{"nodes": [{"id": "docs_implementation_architecture", "label": "Implementation Architecture \u2014 Deepfake Detector (DFD)", "file_type": "document", "source_file": "docs/implementation-architecture.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_dinov2_backbone", "label": "D1: Frozen DINOv2-base Backbone", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best generalization-per-FLOP; linear probes on DINO beat forensic CNNs in the wild."}, {"id": "docs_implementation_architecture_dinov3", "label": "DINOv3 Backbone (gated, model.layer blocks)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L328-L335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a pure config swap: blocks live at model.layer; LoRA attaches to 6 projections and 4 register tokens are skipped."}, {"id": "docs_implementation_architecture_lora_qv", "label": "D2: LoRA r=8 on Q/V of Last 3 ViT Blocks", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks off-the-shelf white-box adversarial transfer from the public backbone; cheap. Risk: may re-introduce overfitting, ablate on LOGO."}, {"id": "docs_implementation_architecture_multi_layer_features", "label": "D3: Multi-Layer Token Features (CLS + mean-patch, layers 4/8/10/12)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-level forensic traces live in earlier layers; final-CLS linear probes discard them."}, {"id": "docs_implementation_architecture_vib_head", "label": "D4: VIB Head with Annealed Beta", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L24, L88-L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suppresses dataset shortcuts without semantic collapse; beta warm-up to 1e-3 over 30% of steps, clamped to [beta_min, beta_max]."}, {"id": "docs_implementation_architecture_beauty_filter_head", "label": "D5: Auxiliary Beauty-Filter Head", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L25, L102-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuts beauty-filter false positives; label applied to both classes so it can't become a label proxy (lambda_b=0.2)."}, {"id": "docs_implementation_architecture_temporal_adapter", "label": "D6: Temporal Adapter + Top-k Logit Pooling + Keyframe Selection", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L26, L108-L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-backbone depthwise Conv1d (k=3,5) keeps feature caching; in-block StA deferred due to latency; top-k robust to burst-only fakes and VFR."}, {"id": "docs_implementation_architecture_stage1_student", "label": "D7: Stage 1 Distilled MobileNetV4-Conv-Small Student", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L27, L163-L172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bitstream/DCT screeners reflect the encoder, not the generator. Kill-switch: drop Stage 1 if it can't pass >=60% of traffic at student FNR <=0.5%."}, {"id": "docs_implementation_architecture_stage3_vlm_route", "label": "D8: Stage 3 VLM Route (Qwen3.6-VL LoRA SFT on Tinker)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L28, L176-L189, L374-L467", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tinker trains VLMs only; adds backbone diversity (HEDGE-style). Score = log p(fake) - log p(real). Lower AUC but higher low-FPR detection than core: an escalation signal, not a replacement."}, {"id": "docs_implementation_architecture_pte", "label": "D9: Platform Transcoding Emulation (PTE)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L29, L139-L152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied identically to both classes (1-3 hops of resize/JPEG/WebP/blur/beauty) to prevent format/compression shortcuts (DDA, PLADA); crop not resize preserves pixel traces."}, {"id": "docs_implementation_architecture_moderation_metrics", "label": "D10: Metrics AUC, TPR@1%FPR, TPR@0.1%FPR, ECE per Slice", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L30, L206-L215", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderation runs at fixed FPR budgets."}, {"id": "docs_implementation_architecture_calibration_verdicts", "label": "D11: Temperature Scaling + 3-Way Verdict (real/abstain/fake)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L31, L193-L202", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abstain band feeds human review; thresholds persisted in calibration.json. Calibration does not transfer across generators."}, {"id": "docs_implementation_architecture_stage2_core_model", "label": "Stage 2 Core Model (DINOv2 + LoRA + VIB)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L76-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen backbone means cheap head retrains for new generators (continual-update path)."}, {"id": "docs_implementation_architecture_tiered_inference_funnel", "label": "Tiered Inference Funnel (Stage0 hash -> Stage1 -> Stage2 -> Stage3)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_tiny_genimage", "label": "Tiny-GenImage Dataset (TheKernel01/Tiny-GenImage)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L131, L247-L250", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inherits GenImage JPEG/size bias (real=ImageNet JPEG, fake=PNG, all fakes square); LOGO numbers overstate in-the-wild performance."}, {"id": "docs_implementation_architecture_in_the_wild_eval_sets", "label": "Held-Out In-the-Wild Eval Sets (Deepfake-Eval-2024, TrueFake, SIDA, Omni-Fake)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_logo_split", "label": "Leave-One-Generator-Out (LOGO) Generalization Split", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L213-L215", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_nested_logo_protocol", "label": "Nested LOGO Protocol (fit / select GLIDE / test Midjourney)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L337-L352", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-distribution checkpoint selection picked the worse epoch for unseen generators; a second held-out generator proxies generalization during selection; test scored once."}, {"id": "docs_implementation_architecture_multi_crop_scoring", "label": "Multi-Crop Scoring (3x3 grid + centre, top-25% mean)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L354-L372", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "+0.051 AUC on clean but no gain under platform compression (real tiles score high more often); stays opt-in with its own calibration and calibration_mismatch flag."}, {"id": "docs_implementation_architecture_square_crop_shortcut_fix", "label": "VLM Size/Aspect Shortcut Fix (DEFAULT_SQUARE_SIZE=448)", "file_type": "rationale", "source_file": "docs/implementation-architecture.md", "source_location": "L388-L397", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Image size alone gave AUC 1.000 on GLIDE since all GenImage fakes are square; VLM sees aspect via token grid, so both classes get identical square crops."}, {"id": "docs_implementation_architecture_route_fusion", "label": "Route Fusion (logistic regression on core + VLM logits)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L184-L187, L433-L461", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fit on fit split only; GLIDE gain did not replicate on Midjourney test; do not deploy fused thresholds without generator-diverse calibration."}, {"id": "docs_implementation_architecture_hedge_dual_gate", "label": "HEDGE-Style Dual-Gate (drop route deviating >3 sigma)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L186-L187", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_bias_controls", "label": "Bias Controls (DDA format alignment, B-Free aligned pairs, size jitter)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L154-L159", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_milestones", "label": "Milestones S1-S7", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L231-L241", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_build_log", "label": "Build Log & Results (\u00a711)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L259-L467", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_compute_plan", "label": "Compute Plan (MPS dev, cloud GPU, Tinker, TensorRT)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L219-L227", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "code_review_logo_holdout_leak", "target": "docs_implementation_architecture_nested_logo_protocol", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/implementation-architecture.md", "source_location": "L273-L275", "weight": 1.0}, {"source": "docs_implementation_architecture_stage2_core_model", "target": "docs_implementation_architecture_dinov2_backbone", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/implementation-architecture.md", "source_location": "L82", "weight": 1.0}, {"source": "docs_implementation_architecture_stage2_core_model", "target": "docs_implementation_architecture_lora_qv", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/implementation-architecture.md", "source_location": "L82", "weight": 1.0}, {"source": "docs_implementation_architecture_stage2_core_model", "t