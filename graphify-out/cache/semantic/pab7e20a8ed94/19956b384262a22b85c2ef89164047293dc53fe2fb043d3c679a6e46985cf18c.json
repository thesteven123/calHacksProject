{"nodes": [{"id": "research_evidence_and_next_steps_roadmap", "label": "Empirical Evidence & Further Implementation Research Roadmap", "file_type": "document", "source_file": "research/evidence_and_next_steps.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": "ML Literature Review & Research Agent", "contributor": null}, {"id": "research_evidence_and_next_steps_multi_cloud_budget_allocation", "label": "Multi-Cloud Compute & Budget Allocation Matrix ($226.80)", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split workloads across RunPod (batch training), Modal (serverless latency tests + demo hosting), Tinker (VLM SFT) and local MPS (smoke tests) so no single platform becomes a bottleneck."}, {"id": "research_evidence_and_next_steps_runpod", "label": "RunPod ($50 credit, batch GPU training)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTX 4090 / A40 hourly instances suit TemporalAdapter training, LOGO sweeps and MobileNetV4 distillation."}, {"id": "research_evidence_and_next_steps_modal", "label": "Modal ($30 credit, serverless testing & demo host)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-second billing and <2s cold starts make it ideal for P95/P99 latency benchmarks and hosting the live Gradio/Streamlit demo."}, {"id": "research_evidence_and_next_steps_tinker", "label": "Tinker API ($146.80 credit, VLM LoRA SFT)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_local_mps", "label": "Local Mac MPS (smoke tests)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_multi_crop_vs_center_crop", "label": "Multi-Crop vs Centre-Crop Under Social Compression", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-crop gave +0.051 AUC clean but zero gain under PTE (\u0394AUC \u22120.014) because tiling made compression blocks on reals spuriously raise fake logits; keep crop_mode=\"center\" by default, multi-crop opt-in for localized inpainting benchmarks."}, {"id": "research_evidence_and_next_steps_platform_transcoding_emulation", "label": "Platform Transcoding Emulation (PTE)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_aspect_ratio_leakage", "label": "Aspect-Ratio & Dimension Leakage Shortcut", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100% of GenImage fakes were square while 98% of reals were not, giving an artificial 0.983 AUC; standardizing to DEFAULT_SQUARE_SIZE=448 reset true AUC to 0.871. Future video crops must use fixed 1:1 face boxes (1.35x margin) to avoid device-identity leakage."}, {"id": "research_evidence_and_next_steps_default_square_size_448", "label": "DEFAULT_SQUARE_SIZE = 448", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_foundation_model_complementarity", "label": "Foundation Model Complementarity (DINOv2 vs Qwen3.6-35B-VL)", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Midjourney holdout: DINOv2 AUC 0.844/TPR@1%FPR 0.096, VLM AUC 0.826/0.256, fused AUC 0.854/0.216; score correlation r=0.78 shows the VLM captures semantic inconsistencies DINOv2 misses, especially at low-FPR budgets."}, {"id": "research_evidence_and_next_steps_dinov2_core_detector", "label": "Core DINOv2 Detector (DINOv2 + LoRA + VIB)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_qwen_vlm_route", "label": "VLM Route (Qwen3.6-35B-VL LoRA)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_fused_route", "label": "Fused Route (DINOv2 + VLM)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_midjourney_holdout", "label": "Midjourney Holdout Test Set", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_ood_calibration_breakdown", "label": "OOD Calibration Breakdown (FNR 2.0% \u2192 16.8%)", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temperature and thresholds fitted on known generators assume i.i.d. data; unseen generators are genuine OOD covariate shifts, so missed fakes surged from 2.0% to 16.8% on Midjourney."}, {"id": "research_evidence_and_next_steps_temperature_scaling", "label": "Post-hoc Temperature Scaling", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_hackathon_execution_funnel", "label": "Hackathon Execution Funnel (Phases A\u2013D)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_split_conformal_prediction", "label": "Split-Conformal Prediction with Monotone Non-Conformity Scores", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Priority 1: pure post-processing (zero GPU) that bounds FPR \u2264 \u03b1=0.01 via the (1\u2212\u03b1) empirical quantile of P(fake) on held-out reals, with REAL / FLAG FAKE / ABSTAIN decision bands; fixes the 16.8% FNR spike."}, {"id": "research_evidence_and_next_steps_abstain_escalate_band", "label": "Abstain / Escalate Decision Band", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_calibration_py", "label": "dfd/eval/calibration.py", "file_type": "code", "source_file": "research/evidence_and_next_steps.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_stage4_video_extension", "label": "Stage 4 Video Extension (Low Budget)", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3D-CNNs/VideoMAE infeasible on hackathon budget; reuse frozen DINOv2 multi-layer features (d=6144) on 8\u201316 keyframes, train only a <1.5M-param 1D temporal adapter + head, aggregate with top-k pooling."}, {"id": "research_evidence_and_next_steps_temporal_adapter", "label": "TemporalAdapter (src/dfd/models/temporal.py)", "file_type": "code", "source_file": "research/evidence_and_next_steps.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depthwise 1D convolutions (k=3,5) with residual scaling \u03b3 over [B,T,d] frame sequences."}, {"id": "research_evidence_and_next_steps_top_k_mean_pooling", "label": "Residual-Guided / Top-k Mean Logit Pooling", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deepfake temporal glitches (facial feature drift) are localized, so averaging the top k=max(2,\u230a0.25T\u230b) frame logits avoids diluting sparse artifacts."}, {"id": "research_evidence_and_next_steps_video_datasets", "label": "Quick Video Datasets (Celeb-DF-v2 subset, DeepFakeFace, OpenForensics/SIDA)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_mobilenetv4_student_distillation", "label": "Stage 1 MobileNetV4-Conv-Small Student Distillation", "file_type": "rationale", "source_file": "research/evidence_and_next_steps.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows 10\u201320x throughput (<1.5 ms vs 35 ms ViT-B/14), proving production readiness; high-recall threshold \u03c41=0.02 fast-paths 75\u201380% of benign uploads while leaking <0.2% of fakes."}, {"id": "research_evidence_and_next_steps_distillation_loss", "label": "BCE + KL Distillation Loss", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_distill_py", "label": "scripts/distill.py", "file_type": "code", "source_file": "research/evidence_and_next_steps.md", "source_location": "L170", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_logo_cross_validation", "label": "Leave-One-Generator-Out (LOGO) Sweep", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_vlm_forensic_rationale", "label": "VLM Forensic Rationale (2-sentence explanations)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L146", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_hackathon_demo", "label": "Hackathon Demo & Presentation Architecture (Gradio/Streamlit on Modal)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_evidence_and_next_steps_tiered_funnel", "label": "Tiered Funnel (Stage 0 \u2192 Stage 1 \u2192 Stage 2 \u2192 escalation)", "file_type": "concept", "source_file": "research/evidence_and_next_steps.md", "sourc