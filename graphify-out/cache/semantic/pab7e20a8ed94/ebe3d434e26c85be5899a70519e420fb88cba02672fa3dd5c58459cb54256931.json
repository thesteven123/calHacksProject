{"nodes": [{"id": "docs_architecture_spec_architecture_specification", "label": "Social Media Deepfake Detection Architecture Specification", "file_type": "document", "source_file": "docs/architecture-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_spec_tiered_ingestion_funnel", "label": "Tiered Ingestion Funnel (Stage 0-3)", "file_type": "rationale", "source_file": "docs/architecture-spec.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meets throughput (millions of uploads/day) and latency budgets: Stage 1 <5ms, Stage 2 <35ms, Stage 3 async <500ms; most traffic exits early."}, {"id": "docs_architecture_spec_stage0_provenance_dedup", "label": "Stage 0: Metadata, Provenance & Deduplication (C2PA, PDQ/pHash, face detection 1.35x padding)", "file_type": "concept", "source_file": "docs/architecture-spec.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.35x bbox padding captures blend boundaries; known matches get instant verdict."}, {"id": "docs_architecture_spec_stage1_front_door_screener", "label": "Stage 1: Front-Door Screener (MobileNetV4-Small / EfficientNet-B0 on DCT/residuals)", "file_type": "concept", "source_file": "docs/architecture-spec.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passes obvious authentic media (80-85% of traffic) under 5ms."}, {"id": "docs_architecture_spec_stage2_core_forensic_detector", "label": "Stage 2: Core Forensic Detector (~25-35ms)", "file_type": "concept", "source_file": "docs/architecture-spec.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_spec_stage3_escalation_tier", "label": "Stage 3: Escalation Tier (async ensemble, NSG, AV s