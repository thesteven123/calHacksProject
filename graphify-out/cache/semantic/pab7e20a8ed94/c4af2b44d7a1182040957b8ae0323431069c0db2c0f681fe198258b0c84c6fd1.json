{"nodes": [{"id": "docs_implementation_architecture_implementation_architecture", "label": "Implementation Architecture - Deepfake Detector (DFD)", "file_type": "document", "source_file": "docs/implementation-architecture.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_d1_frozen_dinov2_backbone", "label": "D1: Frozen facebook/dinov2-base Backbone", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best generalization-per-FLOP; HF ungated; DINOv3 is a config swap once gated access is granted."}, {"id": "docs_implementation_architecture_d2_lora_qv", "label": "D2: LoRA r=8 on Q/V of last 3 ViT blocks", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breaks off-the-shelf white-box adversarial transfer from the public backbone (critique \u00a71.1); risk: may re-introduce overfitting, ablate vs frozen-only."}, {"id": "docs_implementation_architecture_d3_multi_layer_token_features", "label": "D3: Multi-layer token features (CLS + mean-patch from layers 4,8,10,12; 6144-d)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-level forensic traces live in earlier layers; final-CLS linear probes discard them (Gemini critique)."}, {"id": "docs_implementation_architecture_d4_vib_head_annealed_beta", "label": "D4: VIB Head with annealed beta schedule (floor/cap)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suppresses dataset shortcuts without semantic collapse; beta warm-up 0->1e-3 over first 30% of steps; d_z=128."}, {"id": "docs_implementation_architecture_d5_aux_beauty_filter_head", "label": "D5: Auxiliary Beauty-Filter Head (multi-task, lambda_b=0.2)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuts beauty-filter false positives; filter applied to real and fake so label cannot proxy class."}, {"id": "docs_implementation_architecture_d6_temporal_adapter_topk", "label": "D6: Post-backbone Temporal Adapter (depthwise Conv1d k=3,5) + top-k pooling + change-based keyframe selection", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviates from spec's in-block StA because in-block adapters break feature caching and add latency; top-k (k=ceil(0.25T)) robust to burst-only fakes and VFR."}, {"id": "docs_implementation_architecture_d7_distilled_mobilenetv4_student", "label": "D7: Distilled MobileNetV4-Conv-Small Stage 1 Student", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces spec's bitstream/DCT screener because bitstream reflects the encoder, not the generator (critique \u00a71.4); student FNR vs teacher <=0.5%."}, {"id": "docs_implementation_architecture_d8_tinker_vlm_route", "label": "D8: Tinker VLM Route (Qwen3.5/3.6-VL LoRA SFT, log-prob score)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tinker trains VLMs only; adds backbone diversity HEDGE-style. Score = log p(fake) - log p(real) at temperature 0."}, {"id": "docs_implementation_architecture_d9_pte", "label": "D9: Platform Transcoding Emulation applied identically to both classes", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents format/compression shortcuts (DDA, PLADA); 1-3 hops of resize bucket, JPEG/WebP q30-95, blur/noise, beauty filter p=0.25, crop not resize."}, {"id": "docs_implementation_architecture_d10_metrics", "label": "D10: Metrics AUC, TPR@1%FPR, TPR@0.1%FPR, ECE per-slice", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderation runs at fixed FPR budgets."}, {"id": "docs_implementation_architecture_d11_calibrated_three_way_verdict", "label": "D11: Calibrated probability + 3-way verdict (temperature scaling, tau_real/tau_fake, abstain)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abstain band feeds human review with priority p_uncertain*log10(velocity+1); Grad-CAM maps not shipped to moderators per Gemini critique."}, {"id": "docs_implementation_architecture_dfd_package_layout", "label": "src/dfd package layout (models, data, training, eval, inference, tinker_route)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_tiered_inference_pipeline", "label": "Tiered inference pipeline (inference/pipeline.py: Stage0 hash -> Stage1 student -> Stage2 core -> Stage3 escalate)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_stage3_route_fusion", "label": "Stage 3 route fusion (logit-space weighted average + 3-sigma dual-gate)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L176", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes: A high-res 448px Stage 2, B Tinker VLM, C optional DINOv3-L/MetaCLIP2 probe; weights fit via logistic regression on validation."}, {"id": "docs_implementation_architecture_tiny_genimage", "label": "Tiny-GenImage (TheKernel01/Tiny-GenImage)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open, 35k images, 8 generators; GenImage-derived so carries JPEG(real)/PNG(fake) bias."}, {"id": "docs_implementation_architecture_logo_split", "label": "Leave-One-Generator-Out (LOGO) generalization protocol", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L213", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_implementation_architecture_s3_midjourney_results", "label": "S3 results: LOGO Midjourney held-out (AUC 0.964 clean, unseen TPR@1%FPR 0.248, abstain 55%)", "file_type": "concept", "source_file": "docs/implementation-architecture.md", "source_location": "L269", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unseen-generator TPR ~1/3 of in-distribution; heavy recompression costs ~7 AUC overall, 10 on unseen; abstain rate signals need for more data/epochs."}, {"id": "docs_implementation_architecture_milestones_s1_s7", "label": "Implementation milestones S1-S7", "file_type": "concept", "source_file": "docs/implementation-archite